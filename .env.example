# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/social_ai?retryWrites=true&w=majority

# 32-byte key (base64) to encrypt per-store tokens/keys in the DB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes saved store tokens unreadable.
ENCRYPTION_KEY=

# Signs login session cookies (min 32 chars). Changing it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Media storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Platform-level AI keys (NOT used yet: AI keys are entered per store in the app) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
REPLICATE_API_TOKEN=
IDEOGRAM_API_KEY=

# --- Meta app (for OAuth / token exchange) ---
META_APP_ID=
META_APP_SECRET=
